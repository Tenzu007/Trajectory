# ─── DairyPulse Production Backend Environment Configuration ────────────────
ENVIRONMENT=development
PORT=5050
HOST=0.0.0.0

# ─── Database ────────────────────────────────────────────────────────────────
# SQLite by default for zero-friction setup; switch to postgresql://user:pass@host:port/dbname in production
DATABASE_URL=sqlite:///./dairypulse.db

# ─── Security & JWT ──────────────────────────────────────────────────────────
# Replace with a cryptographically generated 256-bit secret in production (openssl rand -hex 32)
JWT_SECRET_KEY=dairypulse_production_super_secret_jwt_key_2024_cooperative_plant4
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# ─── Storage Paths ───────────────────────────────────────────────────────────
UPLOAD_DIR=./uploads
PROCESSED_DIR=./uploads/processed
MODELS_DIR=./models

# ─── AI / Computer Vision ────────────────────────────────────────────────────
YOLO_MODEL_PATH=./models/ppe_yolov8n.pt
CONFIDENCE_THRESHOLD=0.50
IOU_THRESHOLD=0.45
CCTV_RECONNECT_INTERVAL_SECONDS=5

